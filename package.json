{
  "name": "romm-launcher",
  "private": true,
  "version": "0.1.7",
  "description": "Lightweight RomM browser that launches games in locally installed emulators",
  "license": "AGPL-3.0-only",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "package": "npm run build && electron-builder --win portable",
    "release": "npm run package && powershell -NoProfile -Command \"Compress-Archive -Force -Path release/RomM-Launcher.exe -DestinationPath release/RomM-Launcher-$env:npm_package_version.zip\""
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "local.romm.launcher",
    "productName": "RomM Launcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "renderer/**",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "RomM-Launcher.exe"
    }
  }
}
